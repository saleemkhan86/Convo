# ─────────────────────────── Convo API ───────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# PostgreSQL connection (cloud or local). Never commit the real .env.
DATABASE_URL=postgresql://convo:convo@localhost:5432/convo?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-48-byte-secret-change-me-1234567
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Return OTP codes in API responses (local development ONLY; blocked in production)
DEV_EXPOSE_OTP=true

# ─────────────── Email gateway (spec §14) — server-side only ───────────────
# Local dev: Mailpit (docker compose up mailpit) — SMTP on 1025, UI on 8025.
# Leave SMTP_HOST empty to log emails to the API console instead of sending.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Convo <no-reply@convo.local>"

# Abuse prevention (spec §30)
EXTERNAL_EMAIL_DAILY_LIMIT=50

# ─────────────────────────── Convo Web ───────────────────────────
# Direct API URL (optional). Default: use the Vite dev proxy at /api.
# VITE_API_URL=http://localhost:4000

# ────────────────────────── Convo Mobile ─────────────────────────
# API URL reachable FROM the device/emulator.
# Android emulator: http://10.0.2.2:4000 · physical device: your LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

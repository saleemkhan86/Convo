# ─────────────────────────── Convo API ───────────────────────────
# Copy to apps/api/.env — that is the only file the API reads (`--env-file=.env`).
# Never commit the real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Web app origin (the SPA). Not the API — /media is not served from here.
APP_URL=http://localhost:5173
# Public origin of THIS API. Signed media URLs are absolute and built from it,
# so images/videos would 404 (served index.html) if this pointed at the web app.
# Required in production; defaults to http://localhost:<PORT> in development.
# Phones/emulators: set this to the LAN address of the API (e.g. http://192.168.1.10:4000).
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# PostgreSQL connection (cloud or local).
# Supabase: use the SESSION pooler host on port 5432 — the direct host is IPv6-only
# and the transaction pooler (port 6543) breaks Prisma's prepared statements.
DATABASE_URL=postgresql://convo:convo@localhost:5432/convo?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-48-byte-secret-change-me-1234567
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Return OTP codes in API responses (local development ONLY; blocked in production)
DEV_EXPOSE_OTP=true

# ─────────────── Email gateway (spec §14) — server-side only ───────────────
# Local dev: Mailpit (docker compose up mailpit) — SMTP on 1025, UI on 8025.
# Leave SMTP_HOST empty to log emails to the API console instead of sending.
# Production boot THROWS if SMTP_HOST is empty (src/email/index.ts).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Convo <no-reply@convo.local>"

# ─────────────── SMS gateway (spec §3) — no vendor yet ───────────────
# There are NO env vars for SMS: no adapter is implemented. createSmsProvider()
# (src/sms/index.ts) logs the code in development and returns a provider that
# fails phone sign-up with a clear 503 in production. To go live, add
# src/sms/<vendor>.ts implementing SmsProvider and read its keys from config.ts.
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM_NUMBER=

# ─────────────── Media storage (Phase 4B) — server-side only ───────────────
# Status photos/videos (and chat attachments later). Clients only ever receive
# expiring URLs; provider credentials never leave the API.
# local = files under MEDIA_LOCAL_DIR (default .data/media, git-ignored)
# supabase = bucket storage, requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#           and the bucket must already exist in the Supabase console.
MEDIA_STORAGE_PROVIDER=local
# MEDIA_LOCAL_DIR=.data/media
MEDIA_MAX_UPLOAD_BYTES=104857600
MEDIA_URL_TTL_SECONDS=21600
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MEDIA_BUCKET=media

# Abuse prevention (spec §30)
EXTERNAL_EMAIL_DAILY_LIMIT=50

# ─────────────── Link previews + GIF picker (Phase 5B extras) ───────────────
# Giphy API key stays server-side; clients only call our /giphy/* proxy.
# Leave empty to disable the GIF picker (API answers enabled:false).
# GIPHY_API_KEY=
LINK_UNFURL_TIMEOUT_MS=5000
LINK_PREVIEW_MAX_BYTES=2097152

# ─────────────────── Calling (Phase 5F) — server-side only ───────────────────
# WebRTC media is peer-to-peer; the API only owns the call record, the state
# machine and the signaling relay. TURN's shared secret never leaves the server:
# clients get a short-lived HMAC credential minted for their own user id.
STUN_URLS=stun:stun.l.google.com:19302
# Leave TURN_URLS empty for host/server-reflexive only (fine on one LAN).
# TURN_URLS=turn:relay.example.com:3478?transport=udp   ← requires TURN_SECRET too
# TURN_SECRET=at-least-8-bytes-shared-with-coturn
TURN_CREDENTIAL_TTL_SECONDS=3600
# How long a ring lasts before the call is logged as missed.
CALL_RING_TIMEOUT_SECONDS=45
# How often the sweep reaps stuck rings (survives an API restart mid-ring).
CALL_SWEEP_SECONDS=15

# ───────────────────── Redis realtime (multi-node) ─────────────────────
# Unset = single-process in-memory hub: fine locally, wrong across nodes.
# MUST be a TCP endpoint (rediss://). The Upstash REST pair
# (UPSTASH_REDIS_REST_URL / _TOKEN) cannot drive ioredis and is not read here.
# REDIS_URL=rediss://default:<token>@<region>.upstash.io:6379
REDIS_PREFIX=convo:

# ───────────────────────── Push (Phase 5G) ─────────────────────────
# Everything here is server-side; the only key a client sees is the VAPID
# public one, which is public by design. With nothing configured the app still
# works — alerts land in the centre and over the socket, they just never wake a
# closed app. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY must be set together.
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@convo.local

# ────────────────── Security sweeps (Phase 5C) ──────────────────
# Grace before a deletion request becomes final (WhatsApp uses 30 days).
ACCOUNT_DELETION_GRACE_DAYS=30
# How often expired disappearing messages are drained.
EPHEMERAL_SWEEP_SECONDS=60
# How often past-grace deletions are finalised.
DELETION_SWEEP_SECONDS=3600
# How often expired feed posts (7-day auto-delete) are pruned.
FEED_SWEEP_SECONDS=3600

# ────────────────────────── ⚠ TEST_DATABASE_URL ──────────────────────────
# Do NOT add this to apps/api/.env. Vitest loads this file the way Vite does, so
# a defined TEST_DATABASE_URL silently arms the integration suites in `pnpm test`
# — and those call deleteMany() on users, conversations, messages, contacts,
# refresh tokens and audit rows in beforeAll. On 2026-10-23 an intended
# unit-only run did exactly that and wiped development data.
# Unit tests are the default (vitest.config.ts excludes test/integration/**).
# To run integration deliberately, point this at a THROWAWAY database and use
# the explicitly-named script: pnpm test:integration:wipes-shared-db
# TEST_DATABASE_URL=

# ─────────────────────────── Convo Web ───────────────────────────
# These belong in apps/web/.env.local (git-ignored), not this file.
# Direct API URL (optional). Default: use the Vite dev proxy at /api.
# VITE_API_URL=http://localhost:4000
# What the dev proxy forwards /api to (apps/web/vite.config.ts).
# VITE_API_PROXY=http://localhost:4000

# ────────────────────────── Convo Mobile ─────────────────────────
# This belongs in apps/mobile/.env (git-ignored), not this file.
# API URL reachable FROM the device/emulator.
# Android emulator: http://10.0.2.2:4000 · physical device: your LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

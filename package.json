{
  "name": "convo",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:api": "pnpm --filter @convo/api dev",
    "dev:web": "pnpm --filter @convo/web dev",
    "dev:mobile": "pnpm --filter @convo/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @convo/api prisma:migrate",
    "db:seed": "pnpm --filter @convo/api prisma:seed"
  }
}
